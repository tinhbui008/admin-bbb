PORT=3000

# PostgreSQL Database
DATABASE_URL=postgresql://bbb:bbb@localhost:5432/bbb_admin

# BBB Configuration
BBB_API_BASE_URL=https://your-bbb-domain.example.com/bigbluebutton/api
BBB_SHARED_SECRET=your_bbb_shared_secret
BBB_CALLBACK_URL=https://your-admin-domain.example.com/webhook/bbb
BBB_AUTO_REGISTER_HOOK=false
BBB_GET_RAW=false
BBB_EVENT_IDS=
BBB_USE_BEARER_AUTH=true

# Greenlight DB (read-only) — for showing room access-code state + change history.
# Optional: leave blank to disable the access-code panel entirely.
# Use a read-only role (e.g. bbb_admin_ro), not the postgres superuser.
# NOTE: host must unambiguously resolve to the Greenlight postgres from the
# dashboard container (the name `postgres` may clash with the dashboard's own DB);
# use the Greenlight postgres container IP or a dedicated network alias if needed.
GREENLIGHT_DATABASE_URL=
